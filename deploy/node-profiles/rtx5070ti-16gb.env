# RTX 5070 Ti (16 GB VRAM): primary coordinator, RAG, and quality worker.
# Load with: ./scripts/docker/up-node.sh rtx5070ti-16gb

LLAMAFARM_NODE_NAME=llamafarm-rtx5070ti-16gb
LLAMAFARM_DEFAULT_ROLE=both
LLAMAFARM_DISCOVERY_MODE=manual
LLAMAFARM_ALLOW_REMOTE_SUBAGENTS=true

# Publish only the direct-access LlamaFarm gateway to the LAN. Raw Ollama and Qdrant
# ports remain local to this host.
LLAMAFARM_HOST_BIND_IP=0.0.0.0
OLLAMA_HOST_BIND_IP=127.0.0.1
QDRANT_HOST_BIND_IP=127.0.0.1
LLAMAFARM_GATEWAY_HOST=0.0.0.0
LLAMAFARM_ALLOW_PUBLIC_BIND=true

# One high-quality stream is materially better than six competing 128K streams
# on 16 GB. Promote to 96K only after the benchmark proves it sustainable.
LLAMAFARM_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_LENGTH=65536
OLLAMA_NUM_CTX=65536
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_GPU_OVERHEAD=1073741824
OLLAMA_KEEP_ALIVE=10m

LLAMAFARM_AGENT_COMPACT_CONTEXT=true
LLAMAFARM_AGENT_MAX_HISTORY_MESSAGES=48
LLAMAFARM_AGENT_MAX_TOOL_ITERATIONS=96
LLAMAFARM_AGENT_PARALLEL_TOOLS=false
# Give deep work longer segments while retaining a reliable checkpoint cadence.
# The overall job remains unlimited until completion or an operator Stop.
LLAMAFARM_AGENT_MAX_OUTPUT_TOKENS=8192

# The 123 GB host-RAM pool is available for RAG, document work, and deliberate
# CPU-offloaded experiments. It is not used to hide a permanently overloaded
# interactive model.
LLAMAFARM_MEMORY_LIMIT=96g
LLAMAFARM_CPU_LIMIT=12
LLAMAFARM_PIDS_LIMIT=2048
QDRANT_MEMORY_LIMIT=8g
QDRANT_CPU_LIMIT=4
QDRANT_PIDS_LIMIT=1024
