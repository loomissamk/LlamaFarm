# RTX 5070 Ti (16 GB VRAM): primary coordinator, RAG, and quality worker.
# Load with: ./scripts/docker/up-node.sh rtx5070ti-16gb

LLAMAFARM_NODE_NAME=llamafarm-rtx5070ti-16gb
LLAMAFARM_DEFAULT_ROLE=both
LLAMAFARM_DISCOVERY_MODE=manual
LLAMAFARM_ALLOW_REMOTE_SUBAGENTS=true

# High-quality sparse MoE default for the 128 GB host. The 35B model activates
# roughly 3B parameters per token while retaining the larger model's quality.
LLAMAFARM_INITIAL_MODEL=qwen3.6:35b-a3b-mtp-q4_K_M

# Publish only the direct-access LlamaFarm gateway to the LAN. Raw Ollama and Qdrant
# ports remain local to this host.
LLAMAFARM_HOST_BIND_IP=0.0.0.0
OLLAMA_HOST_BIND_IP=127.0.0.1
QDRANT_HOST_BIND_IP=127.0.0.1
LLAMAFARM_GATEWAY_HOST=0.0.0.0
LLAMAFARM_ALLOW_PUBLIC_BIND=true

# Keep one high-quality stream and a 64K fast-path allocation. LlamaFarm grows
# requests through 128K to the model-native 256K window only when the estimated
# prompt, tools, and output reserve require it. The 123 GB host-RAM pool makes
# deliberate CPU offload viable for those long requests.
OLLAMA_CONTEXT_LENGTH=65536
OLLAMA_NUM_CTX=65536
LLAMAFARM_ADAPTIVE_CONTEXT=true
LLAMAFARM_ADAPTIVE_CONTEXT_MAX=262144
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KEEP_ALIVE=-1

# Preserve raw working history on the large-memory coordinator so adaptive
# context can see and retain it. The provider grows through 64K/128K/256K and
# rejects a ceiling-pressure response instead of silently losing old input.
LLAMAFARM_AGENT_COMPACT_CONTEXT=false
LLAMAFARM_AGENT_TOOL_ROUTING_ENABLED=true
LLAMAFARM_AGENT_TOOL_ROUTING_TOP_K=12
LLAMAFARM_AGENT_MAX_HISTORY_MESSAGES=0
LLAMAFARM_AGENT_MAX_TOOL_ITERATIONS=0
LLAMAFARM_AGENT_PARALLEL_TOOLS=false
# Explicitly clear any older persisted/profile limit. Ollama generation ends
# naturally or when the operator presses Stop.
LLAMAFARM_AGENT_MAX_OUTPUT_TOKENS=unlimited
LLAMAFARM_WS_PERSISTED_MAX_SESSIONS=0
LLAMAFARM_SCHEDULER_MAX_CONCURRENT=0
LLAMAFARM_SCHEDULER_MAX_TASKS=0

# LlamaFarm and Qdrant intentionally have no Compose CPU, memory, swap, or PID
# ceilings. Large contexts and CPU-offloaded models can use the full 123 GB
# host-RAM pool and every available CPU.
