# Copy this file to ~/.config/llamafarm/node.env on each host, chmod it 600,
# and keep it out of Git. It intentionally contains no real LAN addresses or
# credentials.

# Add the other node's direct gateway endpoint. Use comma separation only when
# more than one peer is intentional.
LLAMAFARM_MANUAL_PEERS=http://<peer-lan-address>:42617

# Use one long random value shared only by the participating nodes. The bundle
# sends it in a federation-only header and rejects LAN task requests without it.
LLAMAFARM_FEDERATION_TOKEN=<shared-random-federation-token>

# Optional private Git repository used as the persistent workspace root. The
# connected GitHub integration brokers authenticated fetch/push operations.
# LLAMAFARM_WORKSPACE_GIT_REMOTE=https://github.com/<owner>/<private-repo>.git

# Optional first-run model. This seeds a newly created persistent config but
# does not override model selections subsequently saved from the dashboard.
# LLAMAFARM_INITIAL_MODEL=qwen3.5:9b

# Optional immutable host-specific override. Leave this unset for normal
# operation so dashboard selections persist in LlamaFarm's config across
# container restarts.
# LLAMAFARM_MODEL=qwen3.5:9b
