# Copy to /etc/llamafarm/v100-cuda-5070-nvk.env and replace every value.
# Values are hardware identifiers, not secrets. Obtain PCI IDs with `lspci -Dn`
# and the V100 UUID with `nvidia-smi --query-gpu=pci.bus_id,uuid --format=csv`.

# Tesla V100 function kept on the proprietary NVIDIA driver for CUDA compute.
V100_PCI_BDF=REPLACE_WITH_V100_PCI_BDF
V100_PCI_VENDOR_ID=REPLACE_WITH_V100_VENDOR_ID
V100_PCI_DEVICE_ID=REPLACE_WITH_V100_DEVICE_ID
V100_GPU_UUID=REPLACE_WITH_V100_GPU_UUID

# RTX 5070 Ti display function bound to Nouveau for NVK/display/gaming only.
# Do not enter its HDMI-audio or USB functions here: the binding script is
# intentionally limited to this one PCI display function.
DISPLAY_GPU_PCI_BDF=REPLACE_WITH_5070TI_DISPLAY_PCI_BDF
DISPLAY_GPU_PCI_VENDOR_ID=REPLACE_WITH_5070TI_VENDOR_ID
DISPLAY_GPU_PCI_DEVICE_ID=REPLACE_WITH_5070TI_DEVICE_ID
